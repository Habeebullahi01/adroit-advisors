---
import Page from '../layouts/Page.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Page
  title="Contact — Adroit Advisors"
  description="Contact Adroit Advisors at Victoria Island, Lagos. ICAN-licensed chartered accountants."
>
  <section class="bg-navy py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 60px, #ffffff 60px, #ffffff 61px), repeating-linear-gradient(90deg, transparent, transparent 60px, #ffffff 60px, #ffffff 61px);"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <span class="section-label text-blue block mb-4">Contact Us</span>
      <h1 class="font-heading text-white text-4xl lg:text-5xl max-w-2xl leading-tight">Get in touch.</h1>
      <p class="mt-4 text-white/60 text-lg">For general enquiries. For proposal requests, <a href="/request-proposal" class="text-white/90 underline hover:text-white">use the proposal form</a>.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <div class="lg:col-span-2">
          <ContactForm />
        </div>

        <div class="space-y-8">
          <div>
            <h3 class="font-body font-semibold text-navy text-base mb-4">Head Office</h3>
            <address class="not-italic text-sm text-grey-mid leading-relaxed space-y-1">
              <p class="text-navy font-medium">Victoria Island, Lagos</p>
              <p>3b Abimbola Awoniyi Close</p>
              <p>Victoria Island, Lagos 106104</p>
              <p>Nigeria</p>
            </address>
          </div>

          <div class="border-t border-grey-border pt-8">
            <h3 class="font-body font-semibold text-navy text-base mb-4">Phone & Email</h3>
            <div class="space-y-2 text-sm text-grey-mid">
              <a href="tel:+2349058997130" class="block hover:text-navy transition-colors">+234 905 899 7130</a>
              <a href="tel:+2349169114972" class="block hover:text-navy transition-colors">+234 916 911 4972</a>
              <a href="tel:+2349054475284" class="block hover:text-navy transition-colors">+234 905 447 5284</a>
              <a href="mailto:info@adroitadvisorsng.com" class="block hover:text-navy transition-colors mt-3">info@adroitadvisorsng.com</a>
            </div>
          </div>

          <!-- Map embed placeholder -->
          <div class="border-t border-grey-border pt-8">
            <div class="bg-grey rounded-xl h-48 flex items-center justify-center border border-grey-border">
              <div class="text-center text-grey-mid">
                <svg class="w-8 h-8 mx-auto mb-2 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <p class="text-xs">Victoria Island, Lagos</p>
              </div>
            </div>
          </div>

          <div class="border-t border-grey-border pt-8">
            <a href="/request-proposal" class="btn-primary w-full text-center block">Request a Proposal</a>
          </div>
        </div>

      </div>
    </div>
  </section>
</Page>
