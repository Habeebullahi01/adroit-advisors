---
import Page from '../layouts/Page.astro';
import ProposalForm from '../components/ProposalForm.astro';
---

<Page
  title="Request a Proposal — Adroit Advisors"
  description="Tell us about your financial or advisory need. An Adroit Advisors partner will respond within one business day."
>
  <!-- Minimal hero -->
  <section class="bg-navy py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 60px, #ffffff 60px, #ffffff 61px), repeating-linear-gradient(90deg, transparent, transparent 60px, #ffffff 60px, #ffffff 61px);"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <span class="section-label text-blue block mb-4">Get in Touch</span>
      <h1 class="font-heading text-white text-4xl lg:text-5xl max-w-2xl leading-tight">Tell us about your need.</h1>
      <p class="mt-4 text-white/60 text-lg max-w-xl">A partner will review your submission and respond within one business day. No junior handoffs.</p>
    </div>
  </section>

  <!-- Form section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Form -->
        <div class="lg:col-span-2">
          <ProposalForm />
        </div>

        <!-- Sidebar -->
        <div class="space-y-8">
          <div>
            <h3 class="font-body font-semibold text-navy text-base mb-4">What happens next</h3>
            <ol class="space-y-4">
              {[
                'Your proposal request is received and reviewed by a partner — not a sales team.',
                'We respond within one business day to schedule a brief introductory call.',
                'On the call, a partner discusses your situation and outlines how we can help.',
                'We provide a written proposal with scope, timeline, and fee structure.',
              ].map((step, i) => (
                <li class="flex items-start gap-3 text-sm text-grey-mid">
                  <span class="w-5 h-5 rounded-full bg-blue text-white text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">{i + 1}</span>
                  {step}
                </li>
              ))}
            </ol>
          </div>

          <div class="border-t border-grey-border pt-8">
            <h3 class="font-body font-semibold text-navy text-base mb-4">Prefer to call?</h3>
            <div class="space-y-2 text-sm text-grey-mid">
              <a href="tel:+2349058997130" class="block hover:text-navy transition-colors">+234 905 899 7130</a>
              <a href="tel:+2349169114972" class="block hover:text-navy transition-colors">+234 916 911 4972</a>
              <a href="mailto:info@adroitadvisorsng.com" class="block hover:text-navy transition-colors mt-3">info@adroitadvisorsng.com</a>
            </div>
          </div>

          <div class="bg-grey rounded-xl p-6 border border-grey-border">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span class="text-xs font-semibold text-navy">Confidentiality</span>
            </div>
            <p class="text-xs text-grey-mid leading-relaxed">All enquiries are handled with strict professional confidentiality. Information you share is used only to assess and respond to your request.</p>
          </div>

          <div class="border-t border-grey-border pt-8">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
              <span class="text-xs font-semibold text-navy">ICAN Licensed Practice</span>
            </div>
            <p class="text-xs text-grey-mid">Victoria Island, Lagos · Nigeria</p>
          </div>
        </div>

      </div>
    </div>
  </section>
</Page>
