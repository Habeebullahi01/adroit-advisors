---
---
<form class="space-y-6" novalidate>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="contact-name" class="block text-sm font-semibold text-navy mb-2">Full Name <span class="text-blue">*</span></label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        class="w-full border border-grey-border rounded-lg px-4 py-3 text-sm text-navy placeholder-grey-mid focus:outline-none focus:ring-2 focus:ring-blue/30 focus:border-blue transition"
        placeholder="Your name"
      />
    </div>
    <div>
      <label for="contact-email" class="block text-sm font-semibold text-navy mb-2">Email Address <span class="text-blue">*</span></label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        class="w-full border border-grey-border rounded-lg px-4 py-3 text-sm text-navy placeholder-grey-mid focus:outline-none focus:ring-2 focus:ring-blue/30 focus:border-blue transition"
        placeholder="you@company.com"
      />
    </div>
  </div>
  <div>
    <label for="contact-message" class="block text-sm font-semibold text-navy mb-2">Message <span class="text-blue">*</span></label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      required
      class="w-full border border-grey-border rounded-lg px-4 py-3 text-sm text-navy placeholder-grey-mid focus:outline-none focus:ring-2 focus:ring-blue/30 focus:border-blue transition resize-none"
      placeholder="How can we help you?"
    ></textarea>
  </div>
  <button type="submit" class="btn-primary px-8 py-3">Send Message</button>
</form>
